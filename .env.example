# Copy this file to ".env" (it is read automatically if python-dotenv is installed) -- NEVER commit .env
# Cloud speech-to-text: set ONE of these keys.  Without a key SVARA uses the local Whisper model.
GROQ_API_KEY=
# OPENAI_API_KEY=

# Optional overrides
# SVARA_STT_ENGINE=auto            # auto (cloud, then local) | cloud | local
# SVARA_STT_PROVIDER=groq          # groq | openai | custom
# SVARA_STT_MODEL=whisper-large-v3 # cloud model name
# SVARA_WHISPER_MODEL=small        # local model: tiny/base/small/medium/large-v3 or a Hugging Face CTranslate2 repo
# SVARA_WHISPER_PATH=D:\models\whisper-small   # folder with a downloaded model (fully offline)
# SVARA_STT_OFFLINE=1              # never contact the network for the local model
